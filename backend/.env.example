# Sao chép thành backend/.env (hoặc đặt biến môi trường) khi chạy trực tiếp, không dùng Docker.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://skillmkt:skillmkt@localhost:5432/skillmkt

# Khoá ký cookie phiên. Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# Microsoft Entra ID
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Audience của access token mà CLI gửi lên (thường là api://<client id của website>)
ENTRA_API_AUDIENCE=
# App registration (public client, bật device code) của CLI và scope CLI xin token.
# Để trống thì CLI dùng ENTRA_CLIENT_ID và <ENTRA_API_AUDIENCE>/.default
ENTRA_CLI_CLIENT_ID=
ENTRA_CLI_SCOPE=
ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Object ID của các nhóm Entra tương ứng với từng vai trò
ENTRA_GROUP_MANAGERS=
ENTRA_GROUP_REVIEWERS=
ENTRA_GROUP_CREATORS=

# Chỉ dùng khi phát triển cục bộ, KHÔNG bật ở production (ứng dụng sẽ từ chối khởi động)
DEV_LOGIN_ENABLED=false

# Lịch ngày làm việc (D31) và ngưỡng duyệt (D18, D28)
WORK_TIMEZONE=Asia/Ho_Chi_Minh
# Một thứ bảy làm việc (YYYY-MM-DD); các thứ bảy làm việc kế tiếp cách mỗi 14 ngày. Để trống = không làm thứ bảy.
WORK_SATURDAY_ANCHOR=
# Ngày lễ, cách nhau bằng dấu phẩy, ví dụ 2026-09-02,2026-09-03
WORK_HOLIDAYS=
REVIEW_OVERDUE_DAYS=5
UNASSIGNED_REMIND_DAYS=1
AUTO_ASSIGN_DAYS=3

# Lưu trữ gói và ảnh (thư mục cục bộ khi dev)
STORAGE_BACKEND=local
STORAGE_DIR=.data/blobs
# STORAGE_BACKEND=azure: dev/Azurite dùng connection string; production dùng account URL +
# Managed Identity (không cần khoá; SAS ký bằng user delegation key).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=skills
# Thời hạn của SAS URL tải gói (phút)
DOWNLOAD_URL_TTL_MINUTES=10

# Danh sách phòng ban chuẩn (cách nhau bằng dấu phẩy); để trống = không ràng buộc
STANDARD_DEPARTMENTS=

# Giới hạn tải lên (D15): gói tối đa 10 MB, ảnh biểu tượng tối đa 512 KB
MAX_PACKAGE_BYTES=10485760
MAX_ICON_BYTES=524288

# Thu thập skill từ nguồn ngoài (D46): khoảng cách giữa hai lần quét tự động
SOURCE_SCAN_INTERVAL_HOURS=24
# Token cho nguồn riêng tư; tên biến phải bắt đầu bằng SOURCE_TOKEN_ và được khai báo
# trong trường credential_name của nguồn.
SOURCE_TOKEN_GITHUB=

# Dọn dẹp định kỳ: bản nháp không gửi duyệt quá N ngày bị xoá (nhắc trước M ngày); nhật ký giữ N năm (D33)
DRAFT_RETENTION_DAYS=30
DRAFT_WARN_DAYS=7
AUDIT_RETENTION_YEARS=3
