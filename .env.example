# Sao chép thành .env ở thư mục gốc (docker compose tự đọc). KHÔNG commit .env.
# Danh sách đầy đủ các biến (chạy không dùng Docker): backend/.env.example.

# Bắt buộc. Tạo bằng:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

POSTGRES_PASSWORD=skillmkt

# Đăng nhập thử không qua Entra (chỉ dev; ứng dụng từ chối khởi động nếu bật ở production)
DEV_LOGIN_ENABLED=true

# Microsoft Entra ID (để trống khi chỉ dùng dev login)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_API_AUDIENCE=
ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/callback
ENTRA_GROUP_MANAGERS=
ENTRA_GROUP_REVIEWERS=
ENTRA_GROUP_CREATORS=

# Danh sách phòng ban chuẩn, cách nhau bằng dấu phẩy; để trống = không ràng buộc
STANDARD_DEPARTMENTS=

# Lịch ngày làm việc (D31)
# WORK_SATURDAY_ANCHOR=
WORK_HOLIDAYS=

# Token GitHub để quét repo riêng tư hoặc tăng hạn mức API (D45). Khai báo nguồn dùng
# GITHUB_TOKEN là token mặc định cho nguồn GitHub không khai báo credential_name. Tên bí mật riêng bắt buộc bắt đầu bằng SOURCE_TOKEN_;
# thêm biến mới ở đây và ở mục environment của docker-compose.yml.
GITHUB_TOKEN=

# Lưu gói và ảnh. Mặc định thư mục cục bộ. Để thử Azure Blob bằng Azurite:
#   STORAGE_BACKEND=azure
#   AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# rồi chạy: docker compose --profile azure up --build  (trong compose, backend gọi Azurite qua tên dịch vụ
# `azurite`; đổi 127.0.0.1 thành azurite ở BlobEndpoint nếu muốn backend trong container gọi được)
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=

# Chạy trực tiếp không dùng Docker (make dev): backend đọc chính file này.
# Docker compose tự đặt DATABASE_URL riêng nên hai dòng dưới không ảnh hưởng khi chạy make up.
DATABASE_URL=postgresql+psycopg://skillmkt:skillmkt@localhost:5432/skillmkt
STORAGE_DIR=.data/blobs
